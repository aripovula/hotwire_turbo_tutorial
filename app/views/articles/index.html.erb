<p style="color: green"><%= notice %></p>

<% content_for :title, "Articles" %>

<h1>Articles</h1>

<div id="articles">
  <% @articles.each do |article| %>
    <%= render article %>
  <% end %>
</div>

<%= link_to "New article", new_article_path %>

<%= turbo_frame_tag "statistics", src: statistics_articles_path, loading: "lazy" do %>
  <p>Loading...</p>
<% end %>

<div style="display:flex; justify-content: space-between; align-items: center; padding: 1rem; border-top: 1px solid #ccc;">
  <%= turbo_frame_tag "details_panel" do %>
  <% end %>
</div>